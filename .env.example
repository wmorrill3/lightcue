# Port the server listens on (binds 127.0.0.1; put a reverse proxy such as Caddy or nginx in front)
PORT=3150
# Public URL of your deployment. Used in API responses, MCP links and share pages.
SITE_URL=http://localhost:3150
# Optional: comma-separated API keys. Requests with header `x-api-key: <key>` get 500 shows/hour instead of 20.
API_KEYS=
